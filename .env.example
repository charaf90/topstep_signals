# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env est gitignore — ne jamais committer les credentials.

# Email / login TopstepX (username pour l'API ProjectX)
PROJECTX_USERNAME=votre_email@example.com

# Clé API générée dans les settings ProjectX
PROJECTX_API_KEY=votre_cle_api_ici

# Identifiant numérique du compte TopstepX (facultatif : auto-détecté si absent)
# Visible dans l'URL du dashboard ou via GET /api/Account/search
PROJECTX_ACCOUNT_ID=
