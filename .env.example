# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env est gitignore — ne jamais committer les credentials.

# ── ProjectX / TopstepX ────────────────────────────────────────────────────
# Email / login TopstepX
PROJECTX_USERNAME=votre_email@example.com

# Clé API générée dans les settings ProjectX
PROJECTX_API_KEY=votre_cle_api_ici

# Identifiant numérique du compte (facultatif : auto-détecté si un seul compte)
PROJECTX_ACCOUNT_ID=

# ── Telegram ───────────────────────────────────────────────────────────────
# Token du bot créé via @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID de votre conversation avec le bot
# Pour le récupérer : envoyer /start au bot puis appeler
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
