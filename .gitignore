# Brouillon : dossier de travail jetable — contenu ignoré, scaffold conservé.
# Tout essai vit ici ; vider avec scripts/clear_brouillon.sh. La base committée
# = le projet SANS brouillon (les essais ne polluent jamais l'historique git).
brouillon/**
!brouillon/README.md
!brouillon/__init__.py
!brouillon/strategies/
!brouillon/strategies/__init__.py
!brouillon/scripts/
!brouillon/scripts/.gitkeep
!brouillon/notes/
!brouillon/notes/.gitkeep
